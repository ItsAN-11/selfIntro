# ── Contact & song-recommendation emails (Resend) ──
# Without RESEND_API_KEY the forms fall back to opening the visitor's mail app.
RESEND_API_KEY=
CONTACT_TO_EMAIL=2021anjaligupta26@gmail.com
# Until you verify your own domain in Resend, keep the default sender.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# ── Live Spotify data on /music ──
# Without these, the page shows the hardcoded lists in data/music.ts.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Your live URL (used for social preview images)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
